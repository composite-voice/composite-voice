---
import "../styles/global.css";
import { PreferencesPanel } from "@lukeocodes/composite-voice-ui";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const sections = [
  { href: "/colors", label: "Colors" },
  { href: "/typography", label: "Typography" },
  { href: "/icons", label: "Icons" },
  { href: "/buttons", label: "Buttons" },
  { href: "/alerts", label: "Alerts" },
  { href: "/badges", label: "Badges" },
  { href: "/forms", label: "Forms" },
  { href: "/cards", label: "Cards" },
  { href: "/loading", label: "Loading" },
  { href: "/tooltips", label: "Tooltips" },
  { href: "/tabs", label: "Tabs" },
  { href: "/pagination", label: "Pagination" },
  { href: "/tables", label: "Tables" },
  { href: "/overlays", label: "Overlays" },
  { href: "/banners", label: "Banners" },
  { href: "/code", label: "Code & Prose" },
];

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || `CompositeVoice Design System — ${title}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — CompositeVoice Design System</title>
    <script is:inline>
      // Apply all saved preferences before first paint to prevent FOUC
      (function() {
        var el = document.documentElement;
        // Theme (color-scheme)
        try {
          var t = localStorage.getItem('cv-theme') || 'system';
          el.style.colorScheme = t === 'system' ? 'light dark' : t;
        } catch(e) {}
        // Contrast
        try {
          var c = localStorage.getItem('cv-contrast');
          if (c && c !== 'system') el.dataset.contrast = c;
        } catch(e) {}
        // Motion
        try {
          var m = localStorage.getItem('cv-motion');
          if (m && m !== 'system') el.dataset.motion = m;
        } catch(e) {}
        // Transparency
        try {
          var tr = localStorage.getItem('cv-transparency');
          if (tr && tr !== 'system') el.dataset.transparency = tr;
        } catch(e) {}
        // Font size
        try {
          var fs = localStorage.getItem('cv-font-size');
          if (fs && fs !== 'base') el.dataset.fontSize = fs;
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="bg-neutral-50 text-foreground font-sans antialiased" itemscope itemtype="https://schema.org/WebPage">
    <!-- Skip to content link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary-600 focus:text-on-filled focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-focus focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <div class="flex min-h-screen">
      <!-- Mobile menu button (hidden on desktop) -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="fixed top-4 left-4 z-40 md:hidden bg-surface border border-neutral-200 rounded-lg p-2 shadow-card"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="sidebar-nav"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>

      <!-- Sidebar overlay (mobile) -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 z-30 bg-surface-overlay hidden md:hidden"
        aria-hidden="true"
      ></div>

      <!-- Sidebar Navigation -->
      <nav
        id="sidebar-nav"
        class="fixed top-0 left-0 w-64 h-screen bg-surface border-r border-neutral-200 overflow-y-auto flex flex-col z-40 -translate-x-full md:translate-x-0 transition-transform"
        aria-label="Design system sections"
        itemscope
        itemtype="https://schema.org/SiteNavigationElement"
      >
        <div class="px-5 py-6 flex items-center justify-between">
          <a href="/" class="block">
            <span class="text-lg font-bold text-primary-600 tracking-tight">CompositeVoice</span>
            <span class="block text-xs text-foreground-muted font-medium mt-0.5">Design System</span>
          </a>
          <!-- Close button (mobile) -->
          <button
            type="button"
            id="mobile-close-btn"
            class="md:hidden p-1 rounded text-foreground-muted hover:text-foreground"
            aria-label="Close navigation menu"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>

        <ul class="px-3 pb-4 space-y-0.5" role="list">
          {sections.map(({ href, label }) => {
            const isActive = currentPath === href || currentPath === `${href}/`;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    "block px-3 py-2 text-sm font-medium rounded-lg transition-colors",
                    isActive
                      ? "bg-primary-50 text-primary-700"
                      : "text-foreground-muted hover:bg-neutral-50 hover:text-foreground",
                  ]}
                  aria-current={isActive ? "page" : undefined}
                  itemprop="url"
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="px-4 pb-6 mt-auto border-t border-neutral-200 pt-4" aria-label="Display preferences">
          <PreferencesPanel client:load />
        </div>
      </nav>

      <!-- Main Content -->
      <main id="main-content" class="flex-1 min-w-0 md:ml-64 pt-16 md:pt-0" itemprop="mainContentOfPage">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
          <header class="mb-8 sm:mb-10">
            <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight" itemprop="name">
              {title}
            </h1>
            {description && (
              <p class="mt-2 text-base sm:text-lg text-foreground-muted" itemprop="description">
                {description}
              </p>
            )}
          </header>

          <slot />
        </div>
      </main>
    </div>

    <!-- Mobile sidebar toggle script -->
    <script is:inline>
      (function() {
        var btn = document.getElementById('mobile-menu-btn');
        var closeBtn = document.getElementById('mobile-close-btn');
        var sidebar = document.getElementById('sidebar-nav');
        var overlay = document.getElementById('sidebar-overlay');
        if (!btn || !closeBtn || !sidebar || !overlay) return;

        function open() {
          sidebar.classList.remove('-translate-x-full');
          overlay.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          closeBtn.focus();
        }
        function close() {
          sidebar.classList.add('-translate-x-full');
          overlay.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }

        btn.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        overlay.addEventListener('click', close);

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !sidebar.classList.contains('-translate-x-full')) {
            close();
          }
        });
      })();
    </script>
  </body>
</html>
