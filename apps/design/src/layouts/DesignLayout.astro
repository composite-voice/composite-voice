---
import "../styles/global.css";
import { Head } from "astro-capo";
import { SEO } from "astro-seo";
import { Breadcrumbs } from "astro-breadcrumbs";
import { Navbar, Sidebar, Footer } from "@lukeocodes/composite-voice-ui";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} — CompositeVoice Design System`;
const pageDescription = description || `CompositeVoice Design System — ${title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

/* Cross-site URLs from Netlify org-level env vars */
const CV_WEB_URL = import.meta.env.CV_WEB_URL || "/";
const CV_DOCS_URL = import.meta.env.CV_DOCS_URL || "/";
const CV_DESIGN_URL = import.meta.env.CV_DESIGN_URL || "/";

const sites = [
  { href: CV_WEB_URL, label: "Home" },
  { href: CV_DOCS_URL, label: "Docs" },
  { href: CV_DESIGN_URL, label: "Design", current: true },
];

const sections = [
  { href: "/", label: "Overview" },
  { href: "/colors", label: "Colors" },
  { href: "/typography", label: "Typography" },
  { href: "/icons", label: "Icons" },
  { href: "/buttons", label: "Buttons" },
  { href: "/alerts", label: "Alerts" },
  { href: "/badges", label: "Badges" },
  { href: "/forms", label: "Forms" },
  { href: "/cards", label: "Cards" },
  { href: "/loading", label: "Loading" },
  { href: "/tooltips", label: "Tooltips" },
  { href: "/tabs", label: "Tabs" },
  { href: "/pagination", label: "Pagination" },
  { href: "/tables", label: "Tables" },
  { href: "/overlays", label: "Overlays" },
  { href: "/banners", label: "Banners" },
  { href: "/code", label: "Code & Prose" },
];

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <Head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: pageTitle,
          type: "website",
          image: `${Astro.site}og-default.png`,
          url: canonicalUrl,
        },
        optional: { description: pageDescription, siteName: "CompositeVoice Design System" },
      }}
      twitter={{ card: "summary_large_image" }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function() {
        var el = document.documentElement;
        var CK = 'cv-preferences';
        var p = {};

        function ckd() {
          var h = location.hostname;
          if (h === 'localhost' || h === '127.0.0.1') return '';
          if (/\.(netlify\.dev|netlify\.app|vercel\.app|pages\.dev|github\.io)$/.test(h)) return '';
          var s = h.split('.'); return s.length >= 2 ? ';domain=.' + s.slice(-2).join('.') : '';
        }
        function save(v) {
          document.cookie = CK + '=' + encodeURIComponent(JSON.stringify(v)) + ';path=/;max-age=31536000;samesite=lax' + ckd();
        }

        try {
          var sp = new URLSearchParams(location.search);
          var cvp = sp.get('cvp');
          if (cvp) {
            p = JSON.parse(cvp);
            save(p);
            sp.delete('cvp');
            history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp : '') + location.hash);
          } else {
            var m = document.cookie.match(/(^|; )cv-preferences=([^;]*)/);
            if (m) p = JSON.parse(decodeURIComponent(m[2]));
          }
        } catch(e) {}

        el.style.colorScheme = (p.theme && p.theme !== 'system') ? p.theme : 'light dark';
        if (p.contrast && p.contrast !== 'system') el.dataset.contrast = p.contrast;
        if (p.motion && p.motion !== 'system') el.dataset.motion = p.motion;
        if (p.transparency && p.transparency !== 'system') el.dataset.transparency = p.transparency;
        if (p.fontSize && p.fontSize !== 'base') el.dataset.fontSize = p.fontSize;

        document.addEventListener('click', function(e) {
          var a = e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || a.target === '_blank') return;
          try {
            var u = new URL(a.href, location.href);
            if (u.hostname === location.hostname) return;
            var cm = document.cookie.match(/(^|; )cv-preferences=([^;]*)/);
            if (!cm) return;
            e.preventDefault();
            u.searchParams.set('cvp', decodeURIComponent(cm[2]));
            location.href = u.toString();
          } catch(x) {}
        });
      })();
    </script>
  </Head>
  <body class="bg-neutral-50 text-foreground font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary-600 focus:text-on-filled focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-focus focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <Navbar client:load sites={sites} hasSidebar />

    <div class="flex min-h-screen pt-14">
      <Sidebar client:load sections={sections} currentPath={currentPath} ariaLabel="Design system sections" />

      <main id="main-content" class="flex-1 min-w-0 md:ml-64">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
          <Breadcrumbs indexText="Design">
            <style slot="separator">.separator { margin: 0 0.25rem; color: var(--color-foreground-muted); }</style>
            <span slot="separator" class="separator">/</span>
          </Breadcrumbs>

          <header class="mb-8 sm:mb-10">
            <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
              {title}
            </h1>
            {description && (
              <p class="mt-2 text-base sm:text-lg text-foreground-muted">
                {description}
              </p>
            )}
          </header>

          <slot />
        </div>

        <Footer client:load sites={sites} className="mt-auto" />
      </main>
    </div>
  </body>
</html>
