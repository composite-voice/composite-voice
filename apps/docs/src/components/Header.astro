---
import Default from '@astrojs/starlight/components/Header.astro';

const CV_WEB_URL = import.meta.env.CV_WEB_URL || "/";
const CV_DOCS_URL = import.meta.env.CV_DOCS_URL || "/";
const CV_DESIGN_URL = import.meta.env.CV_DESIGN_URL || "/";

const sites = [
  { href: CV_WEB_URL, label: "Home" },
  { href: CV_DOCS_URL, label: "Docs", current: true },
  { href: CV_DESIGN_URL, label: "Design" },
];
---

<div class="site-nav">
  <nav class="site-nav-inner" aria-label="Sites">
    {sites.map(({ href, label, current }) => (
      <a
        href={href}
        class:list={["site-nav-link", { current }]}
        aria-current={current ? "true" : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
</div>

<Default {...Astro.props}><slot /></Default>

<style>
  .site-nav {
    background: var(--sl-color-bg-nav);
    border-bottom: 1px solid var(--sl-color-hairline-light);
    padding: 0.25rem 1rem;
  }
  .site-nav-inner {
    display: flex;
    gap: 0.25rem;
    max-width: 72rem;
    margin: 0 auto;
  }
  .site-nav-link {
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  .site-nav-link:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .site-nav-link.current {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-5);
  }
</style>
