---
/**
 * Header override — uses the same Tailwind classes as the design site header.
 * Composes Starlight's Search alongside our shared branding.
 * Mobile menu toggle is our own implementation that controls Starlight's sidebar
 * via the data-mobile-menu-expanded attribute on document.body.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import { ThemeToggle } from "@lukeocodes/composite-voice-ui";

const CV_WEB_URL = import.meta.env.CV_WEB_URL || "/";
const CV_DOCS_URL = import.meta.env.CV_DOCS_URL || "/";
const CV_DESIGN_URL = import.meta.env.CV_DESIGN_URL || "/";

const sites = [
  { href: CV_WEB_URL, label: "Home" },
  { href: CV_DOCS_URL, label: "Docs", current: true },
  { href: CV_DESIGN_URL, label: "Design" },
];
---

<header class="fixed top-0 left-0 right-0 h-14 z-50 bg-surface border-b border-neutral-200">
  <div class="flex items-center h-full px-4">
    {/* Mobile sidebar toggle — matches design site */}
    <button
      type="button"
      id="cv-mobile-menu-btn"
      class="md:hidden mr-3! p-1.5 -ml-1.5! rounded-md text-foreground-muted hover:text-foreground hover:bg-neutral-100 transition-colors"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="starlight__sidebar"
    >
      <svg class="w-5 h-5 cv-menu-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg class="w-5 h-5 cv-menu-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    {/* Site title */}
    <a href="/" class="flex items-center gap-2 mr-6! shrink-0 no-underline">
      <span class="text-base font-bold text-primary-600 tracking-tight">CompositeVoice</span>
    </a>

    {/* Cross-site nav links */}
    <nav class="flex items-center gap-2 mr-6 shrink-0 no-underline" aria-label="Sites">
      {sites.map(({ href, label, current }) => (
        <a
          href={href}
          class:list={[
            "px-3 py-1.5 text-sm font-medium rounded-md transition-colors no-underline",
            current
              ? "text-foreground bg-neutral-100"
              : "text-foreground-muted hover:text-foreground hover:bg-neutral-100",
          ]}
          aria-current={current ? "true" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    {/* Spacer */}
    <div class="flex-1"></div>

    {/* Search — Starlight's search widget */}
    <div class="flex items-center shrink-0">
      <Search {...Astro.props} />
    </div>

    {/* GitHub link */}
    <a
      href="https://github.com/lukeocodes/composite-voice"
      class="p-2 rounded-md text-foreground-muted hover:text-foreground hover:bg-neutral-100 transition-colors"
      aria-label="GitHub repository"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
    </a>

    {/* Theme toggle */}
    <div class="hidden md:flex items-center ml-2!">
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle — controls Starlight's sidebar via:
  // 1. aria-expanded on the proxy element (CSS sibling selector in PageFrame)
  // 2. data-mobile-menu-expanded on body (Starlight's JS/CSS hooks)
  const btn = document.getElementById('cv-mobile-menu-btn');
  const proxy = document.getElementById('cv-sidebar-proxy');
  if (btn) {
    const openIcon = btn.querySelector('.cv-menu-open') as HTMLElement;
    const closeIcon = btn.querySelector('.cv-menu-close') as HTMLElement;

    function setExpanded(expanded: boolean) {
      btn!.setAttribute('aria-expanded', String(expanded));
      proxy?.setAttribute('aria-expanded', String(expanded));
      if (expanded) {
        document.body.setAttribute('data-mobile-menu-expanded', '');
        document.body.style.overflow = 'hidden';
        if (openIcon) openIcon.style.display = 'none';
        if (closeIcon) closeIcon.style.display = '';
      } else {
        document.body.removeAttribute('data-mobile-menu-expanded');
        document.body.style.overflow = '';
        if (openIcon) openIcon.style.display = '';
        if (closeIcon) closeIcon.style.display = 'none';
      }
    }

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      setExpanded(!isExpanded);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setExpanded(false);
        btn.focus();
      }
    });
  }
</script>

<style>
  /* Override Starlight's nav height to match our h-14 (56px) header */
  :root {
    --sl-nav-height: 3.5rem;
  }

  @media print {
    header { display: none; }
  }
</style>
