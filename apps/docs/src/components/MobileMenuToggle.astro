---
/**
 * MobileMenuToggle override — hidden proxy element.
 * The actual toggle button lives in our Header component.
 * This proxy exists so Starlight's CSS sibling selector
 * ([aria-expanded='true'] ~ .sidebar-pane) still works.
 */
---

<div id="cv-sidebar-proxy" aria-expanded="false" class="cv-sidebar-proxy"></div>

<style>
  .cv-sidebar-proxy {
    display: none;
  }
  /* Starlight needs [aria-expanded] visible in DOM for the sibling selector,
     but display:none still works because CSS sibling selectors don't require
     visibility — they only check DOM order. */
</style>
