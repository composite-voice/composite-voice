---
import "../styles/global.css";
import { getCollection } from "astro:content";
import { Head } from "astro-capo";
import { SEO } from "astro-seo";
import { Breadcrumbs } from "astro-breadcrumbs";
import { Navbar, Sidebar, Footer } from "composite-voice-ui";
import type { SidebarItem } from "composite-voice-ui";
import { nav, isNavFolder, isNavSection } from "../lib/nav";
import VoiceAgentIsland from "../components/VoiceAgentIsland";
import pkg from "../../../../package.json";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title === "Overview" ? "CompositeVoice Docs" : `${title} — CompositeVoice Docs`;
const pageDescription = description || `CompositeVoice Docs — ${title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

/* Cross-site URLs from Netlify env vars (process.env works in .astro frontmatter at build time) */
const CV_WEB_URL = process.env.CV_WEB_URL || "/";
const CV_DOCS_URL = process.env.CV_DOCS_URL || "/";
const CV_DESIGN_URL = process.env.CV_DESIGN_URL || "/";

const sites = [
  { href: CV_WEB_URL, label: "Home" },
  { href: CV_DOCS_URL, label: "Docs", current: true },
  { href: CV_DESIGN_URL, label: "Design" },
];

/* Build sidebar from nav config + content collection */
const entries = await getCollection("docs");

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function buildFolderGroup(folder: string, label: string) {
  const children = entries
    .filter((e) => e.id.startsWith(`${folder}/`) && !e.id.slice(folder.length + 1).includes("/"))
    .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity))
    .map((e) => ({ href: `${base}/${e.id}`, label: e.data.title }));
  return { label, children };
}

function prefixHref(href: string): string {
  if (href.startsWith('http') || href.startsWith('#')) return href;
  return `${base}${href}`;
}

const sections: SidebarItem[] = nav.map((item) => {
  if (isNavSection(item)) {
    const children: SidebarItem[] = [];
    if (item.href) {
      children.push({ href: prefixHref(item.href), label: "Overview" });
    }
    children.push(
      ...item.subfolders
        .map((sub) => buildFolderGroup(sub.folder, sub.label))
        .filter((group) => group.children.length > 0)
    );
    return { label: item.label, children };
  }
  if (isNavFolder(item)) {
    return buildFolderGroup(item.folder, item.label);
  }
  // NavLink — prefix the href
  return { ...item, href: prefixHref((item as NavLink).href) };
});

const currentPath = Astro.url.pathname;

/* Derive pagefind section filter from the URL path */
const pathWithoutBase = currentPath.replace(/^\/docs\/?/, '');
const topSegment = pathWithoutBase.split('/')[0];
const sectionMap: Record<string, string> = {
  guides: 'Guides',
  reference: 'Reference',
  advanced: 'Advanced',
  api: 'API Reference',
  examples: 'Examples',
};
const pagefindSection = sectionMap[topSegment] ?? 'Overview';

/* Rank guides/reference/advanced higher than API reference in search */
const pagefindWeight: Record<string, string> = {
  guides: '2',
  reference: '2',
  advanced: '1.5',
  examples: '1',
  api: '0.3',
};
const weight = pagefindWeight[topSegment] ?? '1';
---

<html lang="en">
  <Head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalUrl}
      openGraph={{
        basic: {
          title: pageTitle,
          type: "website",
          image: `${Astro.site}og/index.png`,
          url: canonicalUrl,
        },
        optional: { description: pageDescription, siteName: "CompositeVoice Docs" },
      }}
      twitter={{ card: "summary_large_image" }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#41cbbf" />
    <script is:inline>
      (function() {
        var el = document.documentElement;
        var CK = 'cv-preferences';
        var p = {};

        function ckd() {
          var h = location.hostname;
          if (h === 'localhost' || h === '127.0.0.1') return '';
          if (/\.(netlify\.dev|netlify\.app|vercel\.app|pages\.dev|github\.io)$/.test(h)) return '';
          var s = h.split('.'); return s.length >= 2 ? ';domain=.' + s.slice(-2).join('.') : '';
        }
        function save(v) {
          document.cookie = CK + '=' + encodeURIComponent(JSON.stringify(v)) + ';path=/;max-age=31536000;samesite=lax' + ckd();
        }

        try {
          var sp = new URLSearchParams(location.search);
          var cvp = sp.get('cvp');
          if (cvp) {
            p = JSON.parse(cvp);
            save(p);
            sp.delete('cvp');
            history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp : '') + location.hash);
          } else {
            var m = document.cookie.match(/(^|; )cv-preferences=([^;]*)/);
            if (m) p = JSON.parse(decodeURIComponent(m[2]));
          }
        } catch(e) {}

        el.style.colorScheme = (p.theme && p.theme !== 'system') ? p.theme : 'light dark';
        if (p.contrast && p.contrast !== 'system') el.dataset.contrast = p.contrast;
        if (p.motion && p.motion !== 'system') el.dataset.motion = p.motion;
        if (p.transparency && p.transparency !== 'system') el.dataset.transparency = p.transparency;
        if (p.fontSize && p.fontSize !== 'base') el.dataset.fontSize = p.fontSize;

        document.addEventListener('click', function(e) {
          var a = e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || a.target === '_blank') return;
          try {
            var u = new URL(a.href, location.href);
            if (u.hostname === location.hostname) return;
            var cm = document.cookie.match(/(^|; )cv-preferences=([^;]*)/);
            if (!cm) return;
            e.preventDefault();
            u.searchParams.set('cvp', decodeURIComponent(cm[2]));
            location.href = u.toString();
          } catch(x) {}
        });
      })();
    </script>
  </Head>
  <body class="bg-neutral-50 text-foreground font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary-600 focus:text-on-filled focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-focus focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <Navbar client:load sites={sites} version={pkg.version} hasSidebar showSearch searchBasePath="/docs" />

    <div class="flex min-h-screen pt-14">
      <Sidebar client:load sections={sections} currentPath={currentPath} ariaLabel="Documentation sections" />

      <main id="main-content" class="flex-1 min-w-0 md:ml-64">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
          <meta data-pagefind-filter="section[content]" content={pagefindSection} />
          <meta data-pagefind-weight={weight} />

          <Breadcrumbs indexText="Docs" linkTextFormat="capitalized">
            <span slot="separator">/</span>
          </Breadcrumbs>

          <header class="mb-8 sm:mb-10">
            <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">
              {title}
            </h1>
            {description && (
              <p class="mt-2 text-base sm:text-lg text-foreground-muted">
                {description}
              </p>
            )}
          </header>

          <slot />
        </div>

        <Footer client:load sites={sites} className="mt-auto" />
      </main>
    </div>
    <VoiceAgentIsland client:idle />

    <script is:inline>
      // Inject copy-to-clipboard buttons on Prism code blocks
      document.querySelectorAll('pre[class*="language-"]').forEach(function(pre) {
        if (pre.querySelector('.copy-btn')) return;
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.setAttribute('aria-label', 'Copy code');
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        btn.addEventListener('click', function() {
          var code = pre.querySelector('code');
          var text = code ? code.textContent : pre.textContent;
          navigator.clipboard.writeText(text || '').then(function() {
            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            setTimeout(function() {
              btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
            }, 2000);
          });
        });
        pre.appendChild(btn);
      });
    </script>
  </body>
</html>
