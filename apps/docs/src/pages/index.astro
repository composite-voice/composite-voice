---
import DocsLayout from "../layouts/DocsLayout.astro";
import { BrandName } from "@lukeocodes/composite-voice-ui";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<DocsLayout title="Overview" description="CompositeVoice is an open-source SDK for building composable voice interfaces on the web.">
  <div class="space-y-8">
    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-foreground">What is <BrandName />?</h2>
      <p class="text-foreground-muted leading-relaxed">
        <BrandName /> lets you build voice-powered web applications by composing interchangeable
        speech-to-text, LLM, and text-to-speech providers into a unified pipeline. Swap providers,
        configure turn-taking strategies, and manage conversation history — all with a clean,
        event-driven API.
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-semibold text-foreground">Quick Start</h2>
      <div class="bg-surface-sunken rounded-lg border border-neutral-200 p-4">
        <pre class="text-sm font-mono text-foreground"><code>pnpm add @lukeocodes/composite-voice</code></pre>
      </div>
    </section>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href={`${base}/guides/getting-started`} class="group block p-5 bg-surface rounded-xl border border-neutral-200 hover:shadow-card-hover hover:-translate-y-0.5 transition-all">
        <h3 class="text-sm font-semibold text-foreground group-hover:text-primary-600">Getting Started</h3>
        <p class="text-xs text-foreground-muted mt-1">Install, configure, and run your first voice pipeline.</p>
      </a>

      <a href={`${base}/reference/providers`} class="group block p-5 bg-surface rounded-xl border border-neutral-200 hover:shadow-card-hover hover:-translate-y-0.5 transition-all">
        <h3 class="text-sm font-semibold text-foreground group-hover:text-primary-600">Providers</h3>
        <p class="text-xs text-foreground-muted mt-1">STT, LLM, and TTS provider reference and configuration.</p>
      </a>

      <a href={`${base}/reference/events`} class="group block p-5 bg-surface rounded-xl border border-neutral-200 hover:shadow-card-hover hover:-translate-y-0.5 transition-all">
        <h3 class="text-sm font-semibold text-foreground group-hover:text-primary-600">Events</h3>
        <p class="text-xs text-foreground-muted mt-1">Event-driven architecture and typed event reference.</p>
      </a>

      <a href={`${base}/examples`} class="group block p-5 bg-surface rounded-xl border border-neutral-200 hover:shadow-card-hover hover:-translate-y-0.5 transition-all">
        <h3 class="text-sm font-semibold text-foreground group-hover:text-primary-600">Examples</h3>
        <p class="text-xs text-foreground-muted mt-1">31 runnable demo apps covering every provider and pattern.</p>
      </a>
    </div>
  </div>
</DocsLayout>
