---
import "../styles/global.css";
import {
  ThemeToggle,
  ContrastToggle,
  MotionToggle,
  TransparencyToggle,
  FontSizeToggle,
} from "@lukeocodes/composite-voice-ui";

import pkg from "../../../../package.json";

interface Props {
  title?: string;
  description?: string;
}

const { title = "CompositeVoice", description = "Build voice interfaces for the web. An open-source SDK for composable speech-to-text, LLM, and text-to-speech pipelines." } = Astro.props;

const version = pkg.version;

const CV_WEB_URL = import.meta.env.CV_WEB_URL || "/";
const CV_DOCS_URL = import.meta.env.CV_DOCS_URL || "/";
const CV_DESIGN_URL = import.meta.env.CV_DESIGN_URL || "/";

const sites = [
  { href: CV_WEB_URL, label: "Home", current: true },
  { href: CV_DOCS_URL, label: "Docs" },
  { href: CV_DESIGN_URL, label: "Design" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (function() {
        var el = document.documentElement;
        var CK = 'cv-preferences';
        var p = {};

        // Cookie domain for cross-subdomain sharing on custom domains
        function ckd() {
          var h = location.hostname;
          if (h === 'localhost' || h === '127.0.0.1') return '';
          if (/\.(netlify\.dev|netlify\.app|vercel\.app|pages\.dev|github\.io)$/.test(h)) return '';
          var s = h.split('.'); return s.length >= 2 ? ';domain=.' + s.slice(-2).join('.') : '';
        }
        function save(v) {
          document.cookie = CK + '=' + encodeURIComponent(JSON.stringify(v)) + ';path=/;max-age=31536000;samesite=lax' + ckd();
        }

        // Read: URL param (cross-site transfer) → cookie
        try {
          var sp = new URLSearchParams(location.search);
          var cvp = sp.get('cvp');
          if (cvp) {
            p = JSON.parse(cvp);
            save(p);
            sp.delete('cvp');
            history.replaceState(null, '', location.pathname + (sp.toString() ? '?' + sp : '') + location.hash);
          } else {
            var m = document.cookie.match(/(^|; )cv-preferences=([^;]*)/);
            if (m) p = JSON.parse(decodeURIComponent(m[2]));
          }
        } catch(e) {}

        // Apply
        el.style.colorScheme = (p.theme && p.theme !== 'system') ? p.theme : 'light dark';
        if (p.contrast && p.contrast !== 'system') el.dataset.contrast = p.contrast;
        if (p.motion && p.motion !== 'system') el.dataset.motion = p.motion;
        if (p.transparency && p.transparency !== 'system') el.dataset.transparency = p.transparency;
        if (p.fontSize && p.fontSize !== 'base') el.dataset.fontSize = p.fontSize;

        // Transfer prefs via URL param when navigating to a different hostname
        document.addEventListener('click', function(e) {
          var a = e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || a.target === '_blank') return;
          try {
            var u = new URL(a.href, location.href);
            if (u.hostname === location.hostname) return;
            var cm = document.cookie.match(/(^|; )cv-preferences=([^;]*)/);
            if (!cm) return;
            e.preventDefault();
            u.searchParams.set('cvp', decodeURIComponent(cm[2]));
            location.href = u.toString();
          } catch(x) {}
        });
      })();
    </script>
  </head>
  <body class="bg-surface text-foreground font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-primary-600 focus:text-on-filled focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-focus focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>

    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-surface/80 backdrop-blur-md border-b border-neutral-200">
      <div class="max-w-6xl mx-auto flex items-center h-14 px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2 mr-6 shrink-0">
          <span class="text-base font-bold text-primary-600 tracking-tight">CompositeVoice</span>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-badge text-[0.65rem] font-medium bg-primary-100 text-primary-700">v{version}</span>
        </a>

        <nav class="flex items-center gap-1" aria-label="Sites">
          {sites.map(({ href, label, current }) => (
            <a
              href={href}
              class:list={[
                "px-3 py-1.5 text-sm font-medium rounded-md transition-colors",
                current
                  ? "text-foreground bg-neutral-100"
                  : "text-foreground-muted hover:text-foreground hover:bg-neutral-100",
              ]}
              aria-current={current ? "true" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>

        <div class="flex-1"></div>

        <a
          href="https://github.com/lukeocodes/composite-voice"
          class="p-2 rounded-md text-foreground-muted hover:text-foreground hover:bg-neutral-100 transition-colors"
          aria-label="GitHub repository"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>

        <div class="ml-2">
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-neutral-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-10">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 py-8">
          <p class="text-xs text-foreground-muted">
            &copy; {new Date().getFullYear()} CompositeVoice. All rights reserved.
          </p>
          <nav class="flex items-center gap-4" aria-label="Footer navigation">
            <a href={CV_WEB_URL} class="text-xs text-foreground-muted hover:text-foreground transition-colors">Home</a>
            <a href={CV_DOCS_URL} class="text-xs text-foreground-muted hover:text-foreground transition-colors">Docs</a>
            <a href={CV_DESIGN_URL} class="text-xs text-foreground-muted hover:text-foreground transition-colors">Design</a>
            <a href="https://github.com/lukeocodes/composite-voice" class="text-xs text-foreground-muted hover:text-foreground transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
          </nav>
        </div>

        <div
          role="group"
          aria-label="Display preferences"
          class="grid grid-cols-2 sm:grid-cols-4 gap-4"
        >
          <div class="flex flex-col gap-1">
            <span class="text-[0.65rem] font-medium text-foreground-muted uppercase tracking-wider">Font size</span>
            <FontSizeToggle client:load />
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-[0.65rem] font-medium text-foreground-muted uppercase tracking-wider">Contrast</span>
            <ContrastToggle client:load />
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-[0.65rem] font-medium text-foreground-muted uppercase tracking-wider">Motion</span>
            <MotionToggle client:load />
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-[0.65rem] font-medium text-foreground-muted uppercase tracking-wider">Transparency</span>
            <TransparencyToggle client:load />
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
