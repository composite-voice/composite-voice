# Speechmatics API key — STT (mulaw @ 8 kHz), https://portal.speechmatics.com
SPEECHMATICS_API_KEY=your-speechmatics-api-key-here
# Deepgram API key — TTS (mulaw @ 8 kHz); Twilio needs raw telephony audio,
# which a REST/MP3 provider like Speechify cannot supply
DEEPGRAM_API_KEY=your-deepgram-api-key-here
# Anthropic API key — used for the LLM (claude-haiku-4-5), https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Port the HTTP + WebSocket server listens on (optional, defaults to 3080)
PORT=3080
