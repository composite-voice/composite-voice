# Speechmatics API key — STT (pcm_s16le @ 16 kHz), https://portal.speechmatics.com
SPEECHMATICS_API_KEY=your-speechmatics-api-key-here
# Deepgram API key — TTS (linear16 @ 16 kHz); Vonage WebSockets carry raw PCM only
DEEPGRAM_API_KEY=your-deepgram-api-key-here
# Anthropic API key — used for the LLM (claude-haiku-4-5), https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Port the HTTP + WebSocket server listens on (optional, defaults to 3081)
PORT=3081
