# Bot token from the Discord Developer Portal (Bot page → Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token-here
# Server (guild) id — right-click the server name with Developer Mode on → Copy Server ID
DISCORD_GUILD_ID=123456789012345678
# Voice channel id in that server — right-click the channel → Copy Channel ID
DISCORD_CHANNEL_ID=123456789012345678
# Speechmatics API key — STT (pcm_s16le @ 48 kHz)
SPEECHMATICS_API_KEY=your-speechmatics-api-key-here
# Deepgram API key — TTS (24 kHz linear16); Discord playback needs raw PCM
DEEPGRAM_API_KEY=your-deepgram-api-key-here
# Anthropic API key — used for the LLM (claude-haiku-4-5)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
