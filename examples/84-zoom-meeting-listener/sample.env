# Zoom app Client ID (Zoom App Marketplace → your General app → App Credentials)
ZOOM_CLIENT_ID=your-zoom-client-id-here
# Zoom app Client Secret — signs the RTMS handshake HMAC; server-side only
ZOOM_CLIENT_SECRET=your-zoom-client-secret-here
# Zoom webhook Secret Token (app's Features page) — answers the URL-validation challenge
ZOOM_SECRET_TOKEN=your-zoom-webhook-secret-token-here
# Deepgram API key — used for STT (linear16 @ 16 kHz)
DEEPGRAM_API_KEY=your-deepgram-api-key-here
# Anthropic API key — used for the LLM (claude-haiku-4-5) meeting summary
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Webhook server port (ngrok should tunnel to this)
PORT=3084
