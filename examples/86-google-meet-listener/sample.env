# Speechmatics API key — transcribes the meeting's mixed audio via the Vite proxy
SPEECHMATICS_API_KEY=your-speechmatics-api-key-here
# Anthropic API key — Claude Haiku writes the meeting notes via the Vite proxy
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# The Google OAuth access token and spaces/{id} space name are pasted into the UI,
# not read from the environment — see the README for how to obtain them.
