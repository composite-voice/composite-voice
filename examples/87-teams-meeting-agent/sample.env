# Speechmatics API key — real-time STT via the Vite proxy
SPEECHMATICS_API_KEY=your-speechmatics-api-key-here
# Speechify API key — REST TTS via the Vite proxy
SPEECHIFY_API_KEY=your-speechify-api-key-here
# Anthropic API key — Claude Haiku generates the agent's meeting replies via the Vite proxy
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# The ACS user access token and Teams meeting link are pasted into the UI, not read
# from the environment — see the README for how to issue a token with the az CLI.
